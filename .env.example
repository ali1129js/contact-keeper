# Copy to .env and fill in. Never commit the real .env file.
# MongoDB connection string (local MongoDB or a MongoDB Atlas free M0 cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/contact-keeper
# Long random string, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars
# How long issued tokens stay valid
JWT_EXPIRES_IN=7d
# API port for local development
PORT=5000
# Allowed browser origin for CORS (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
